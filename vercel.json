    {
      "source": "/deviz",
      "destination": "/mydarrin-creeaza-deviz"
    },
    {
      "source": "/servicii/:slug",
      "destination": "/mydarrin-produs?slug=:slug&type=serviciu"
    },
    {
      "source": "/materiale/:slug",
      "destination": "/mydarrin-produs?slug=:slug&type=material"
    },
    {
      "source": "/inchirieri/:slug",
      "destination": "/mydarrin-produs?slug=:slug&type=inchiriere"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/auto-confirma-comenzi",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/expira-acces-temporar",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/email-cont-abandonat",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/email-cos-abandonat",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/reminder-profil-partener",
      "schedule": "0 10 * * *"
    }
  ],
  "redirects": [
