{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/index",
      "destination": "/index.html"
    },
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/servicii/:slug",
      "destination": "/mydarrin-catalog.html?categorie=servicii&subcategorie=:slug"
    },
    {
      "source": "/materiale/:slug",
      "destination": "/mydarrin-catalog.html?categorie=materiale&subcategorie=:slug"
    },
    {
      "source": "/inchiriere/:slug",
      "destination": "/mydarrin-catalog.html?categorie=inchirieri&subcategorie=:slug"
    },
    {
      "source": "/catalog/servicii/:categorie",
      "destination": "/mydarrin-catalog.html?categorie=servicii&subcategorie=:categorie"
    },
    {
      "source": "/catalog/materiale/:categorie",
      "destination": "/mydarrin-catalog.html?categorie=materiale&subcategorie=:categorie"
    },
    {
      "source": "/catalog/inchirieri/:categorie",
      "destination": "/mydarrin-catalog.html?categorie=inchirieri&subcategorie=:categorie"
    },
    {
      "source": "/catalog/:tip/:categorie/:slug",
      "destination": "/mydarrin-produs.html?type=:tip&cat=:categorie&slug=:slug"
    },
    {
      "source": "/cos",
      "destination": "/mydarrin-checkout.html"
    },
    {
      "source": "/partener",
      "destination": "/cum-devii-partenerul-nostru.html"
    },
    {
      "source": "/investitor",
      "destination": "/mydarrin-investitori.html"
    },
    {
      "source": "/curier-cartier",
      "destination": "/cum-devii-curier-de-cartier.html"
    },
    {
      "source": "/asigurator",
      "destination": "/ghidul-asiguratorului.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/auto-confirma-comenzi",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/expira-acces-temporar",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/email-cont-abandonat",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/email-cos-abandonat",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/reminder-profil-partener",
      "schedule": "0 10 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/mydarrin-devino-partener.html",
      "destination": "/cum-devii-partenerul-nostru",
      "statusCode": 301
    },
    {
      "source": "/mydarrin-devino-partener",
      "destination": "/cum-devii-partenerul-nostru",
      "statusCode": 301
    },
    {
      "source": "/mydarrin-categorie-servicii.html",
      "destination": "/mydarrin-catalog?categorie=servicii",
      "permanent": true
    },
    {
      "source": "/mydarrin-categorie-servicii",
      "destination": "/mydarrin-catalog?categorie=servicii",
      "permanent": true
    },
    {
      "source": "/mydarrin-categorie-materiale.html",
      "destination": "/mydarrin-catalog?categorie=materiale",
      "permanent": true
    },
    {
      "source": "/mydarrin-categorie-materiale",
      "destination": "/mydarrin-catalog?categorie=materiale",
      "permanent": true
    },
    {
      "source": "/mydarrin-categorie-inchirieri.html",
      "destination": "/mydarrin-catalog?categorie=inchirieri",
      "permanent": true
    },
    {
      "source": "/mydarrin-categorie-inchirieri",
      "destination": "/mydarrin-catalog?categorie=inchirieri",
      "permanent": true
    },
    {
      "source": "/mydarrin-serviciu.html",
      "destination": "/mydarrin-catalog",
      "permanent": true
    },
    {
      "source": "/mydarrin-serviciu",
      "destination": "/mydarrin-catalog",
      "permanent": true
    },
    {
      "source": "/mydarrin-v3.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mydarrin-v3",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mydarrin-v3/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin.mydarrin.homebestpal.com" }],
      "destination": "/mydarrin-superadmin.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "api.mydarrin.homebestpal.com" }],
      "destination": "/api/health",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: https: blob:; script-src 'self' 'unsafe-inline' https://esm.sh https://cdn.tailwindcss.com https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com https://www.googletagmanager.com https://connect.facebook.net https://analytics.tiktok.com https://snap.licdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.tailwindcss.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://*.supabase.co https://esm.sh https://cdn.jsdelivr.net https://ipapi.co https://nominatim.openstreetmap.org https://wa.me https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://www.facebook.com https://connect.facebook.net https://analytics.tiktok.com https://px.ads.linkedin.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}